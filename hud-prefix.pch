#if __has_include(<AvailabilityVersions.h>)
    #import <AvailabilityVersions.h>
#endif

#ifdef __OBJC__
    #if __has_include(<TargetConditionals.h>)
        #import <TargetConditionals.h>
    #endif

    #import <Foundation/Foundation.h>
    #import "src/helpers/private_headers/NSUserDefaults+Private.h"
    #import <UIKit/UIKit.h>
    #import <os/log.h>
#endif

// 偏好文件的路径。**改这里等于改 bundle id 对应的偏好存储位置** —— 0.31 把
// com.leemin.helium 改成 com.corin.Statusbar 时一并改了，所以旧版本的部件设置
// 不会被继承（新 App 是全新的 bundle id，本来也读不到旧的容器）。
#define USER_DEFAULTS_PATH @"/var/mobile/Library/Preferences/com.corin.Statusbar.plist"

// HUD -> APP: Notify APP that the HUD's view is appeared.
#define NOTIFY_LAUNCHED_HUD "com.corin.Statusbar.notification.hud.launched"

// APP -> HUD: Notify HUD to dismiss itself.
#define NOTIFY_DISMISSAL_HUD "com.corin.Statusbar.notification.hud.dismissal"

// APP -> HUD: Notify HUD that the user defaults has been changed by APP.
#define NOTIFY_RELOAD_HUD "com.corin.Statusbar.notification.hud.reload"