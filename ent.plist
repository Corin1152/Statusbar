<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Wi-Fi 接收功率（RSSI）走 MobileWiFi 私有框架与 wifid 通信。
	  下面两条是**必须的**，参考 ProcursusTeam/netctl 的 entitlements：
	    · skip-library-validation —— 加载一个不是本 App 签名的私有框架；
	    · wifi.manager-access      —— wifid 认这个，没有它 MobileWiFi 拒绝服务。
	  第一版就是漏了这两条（只加了公开的 networking.wifi-info，那是给
	  CNCopyCurrentNetworkInfo 用的，跟 MobileWiFi 不是一回事）。
	-->
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<key>com.apple.wifi.manager-access</key>
	<true/>
	<key>com.apple.AXMediaUtilitiesService-access</key>
	<true/>
	<!--
	  RSRP（蜂窝信号小部件）要读 CoreTelephony 的私有信号强度接口，
	  这条权限是 CommCenter 在建立 XPC 连接时校验的。
	  只给 spi：上游 CellularInfo 自己的能力判定就是 exists([… , "spi"])，
	  而它 README 里「无需额外权利可以查询的数据」一节不含 RSRP。
	  真机若读数一直是占位符，再逐个补 internal 等值。
	-->
	<key>com.apple.CommCenter.fine-grained</key>
	<array>
		<string>spi</string>
	</array>
